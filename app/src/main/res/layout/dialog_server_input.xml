<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etDialogLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="Server Name (optional)"
        android:singleLine="true" />

    <EditText
        android:id="@+id/etDialogAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="IP:Port (e.g. play.example.com:7777)"
        android:inputType="textUri"
        android:singleLine="true" />

    <EditText
        android:id="@+id/etDialogPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Server Password (optional)"
        android:inputType="textPassword"
        android:singleLine="true" />
</LinearLayout>
